# Application configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sweety?schema=public

# JWT authentication - replace with a random secret of at least 32 characters
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# Authentication cookie
COOKIE_NAME=sweety_token
COOKIE_SECURE=false

# Timezone
APP_TIME_ZONE=Asia/Kolkata

# Redis
REDIS_URL=redis://localhost:6379

# Report cache duration
REPORT_CACHE_TTL_SECONDS=60

# Demo Patient seed account - replace the password before running the seed
DEMO_USER_NAME=Sweety Demo Patient
DEMO_USER_EMAIL=demo.patient@example.com
DEMO_USER_PASSWORD="CHANGE_ME_TO_A_PASSWORD_AT_LEAST_08_CHARACTERS"

# Optional Doctor seed account - leave email and password empty to skip
DOCTOR_NAME=Sweety Demo Doctor
DOCTOR_EMAIL=demo.doctor@example.com
DOCTOR_PASSWORD="CHANGE_ME_TO_A_PASSWORD_AT_LEAST_08_CHARACTERS"

